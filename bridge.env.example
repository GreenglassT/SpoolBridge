# SpoolBridge Configuration
# Copy this file to bridge.env and fill in your values

# Printer connection (find these on the P2S touchscreen)
PRINTER_IP=192.168.x.x
PRINTER_SERIAL=YOUR_SERIAL_NUMBER
PRINTER_ACCESS_CODE=YOUR_LAN_ACCESS_CODE

# Spoolman API (localhost if bridge runs on same machine)
SPOOLMAN_URL=http://localhost:7912
